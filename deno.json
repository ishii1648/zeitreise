{
  "nodeModulesDir": "none",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "deno.ns"]
  },
  "exclude": [
    ".claude/"
  ],
  "fmt": {
    "exclude": [
      "data/",
      "docs/adr/",
      "docs/archive/",
      "vendor/",
      ".outputs/"
    ]
  },
  "tasks": {
    "build": "deno run --allow-read --allow-write --allow-run scripts/build.ts",
    "build-data": "deno run --allow-net --allow-read --allow-write scripts/build-data.ts",
    "build-rivers": "deno run --allow-net --allow-read --allow-write scripts/build-rivers.ts",
    "build-mountains": "deno run --allow-net --allow-read --allow-write scripts/build-mountains.ts",
    "build-peaks": "deno run --allow-net --allow-read --allow-write scripts/build-peaks.ts",
    "build-marine-labels": "deno run --allow-net --allow-read --allow-write scripts/build-marine-labels.ts",
    "build-cities": "deno run --allow-net --allow-read --allow-write scripts/build-cities.ts",
    "audit-rivers": "deno run --allow-net --allow-read --allow-write scripts/audit-rivers.ts",
    "audit-attribution": "deno run --allow-read --allow-write scripts/audit-attribution.ts",
    "audit-extent-membership": "deno run --allow-read=data --allow-write=.outputs scripts/audit-extent-membership.ts",
    "measure-year-inventory": "deno run --allow-read=data scripts/measure-year-inventory.ts",
    "measure-fief-coverage": "deno run --allow-read=data scripts/measure-fief-coverage.ts",
    "build-attribution": "deno run --allow-read --allow-write scripts/build-attribution.ts",
    "build-colors": "deno run --allow-read --allow-write scripts/build-colors.ts",
    "build-hre": "deno run --allow-net --allow-read --allow-write scripts/build-hre.ts",
    "build-france-fiefs": "deno run --allow-net --allow-read --allow-write scripts/build-france-fiefs.ts",
    "build-hre-fiefs": "deno run --allow-net --allow-read --allow-write scripts/build-hre-fiefs.ts",
    "build-hre-realm": "deno run --allow-net --allow-read --allow-write scripts/build-hre-realm.ts",
    "build-italy-fiefs": "deno run --allow-net --allow-read --allow-write scripts/build-italy-fiefs.ts",
    "build-britain-fiefs": "deno run --allow-net --allow-read --allow-write scripts/build-britain-fiefs.ts",
    "build-sovereign-fiefs": "deno run --allow-net --allow-read --allow-write scripts/build-sovereign-fiefs.ts",
    "build-cliopatria-fiefs": "deno run --v8-flags=--max-old-space-size=8192 --allow-net=raw.githubusercontent.com --allow-env=CLIOPATRIA_ARCHIVE --allow-read --allow-write --allow-run=unzip scripts/build-cliopatria-fiefs.ts",
    "build-borrowed-fiefs": "deno run --allow-read --allow-write scripts/build-borrowed-fiefs.ts",
    "build-fief-dedupe": "deno run --allow-read --allow-write scripts/build-fief-dedupe.ts",
    "build-fief-flat": "deno run --allow-read --allow-write scripts/build-fief-flat.ts",
    "build-coastal-fill": "deno run --allow-read --allow-write scripts/build-coastal-fill.ts",
    "extract-pmtiles": "deno run --allow-net=build-metadata.protomaps.dev --allow-run=pmtiles --allow-read scripts/extract-pmtiles.ts",
    "extract-dem": "deno run --allow-net=s3.amazonaws.com --allow-read --allow-write scripts/extract-dem.ts",
    "next-task": "deno run --allow-read --allow-env --allow-run=gh scripts/next_task.ts",
    "migrate-tasks-to-issues": "deno run --allow-read=docs --allow-write --allow-run=gh scripts/migrate-tasks-to-issues.ts",
    "setup-issue-labels": "deno run --allow-read=docs --allow-run=gh scripts/setup-issue-labels.ts",
    "next-tasks": "deno run --allow-read --allow-env --allow-run=gh scripts/next_tasks.ts",
    "cleanup-branches": "deno run --allow-read --allow-run=git,gh scripts/cleanup_branches.ts",
    "loop-doctor": "deno run --allow-read --allow-run=gh,git scripts/loop_doctor.ts",
    "serve": "deno run --allow-net --allow-read --allow-run=lsof,ps scripts/serve.ts",
    "verify:smoke": "deno run -A scripts/verify/cdp.ts scripts/verify/checks/smoke.ts",
    "verify:smoke:mobile": "deno run -A scripts/verify/cdp.ts --device=mobile scripts/verify/checks/mobile-smoke.ts",
    "verify:startup-faults:mobile": "deno run -A scripts/verify/cdp.ts --device=mobile scripts/verify/checks/startup-faults.ts",
    "verify:smoke:landscape": "deno run -A scripts/verify/cdp.ts --device=landscape scripts/verify/checks/landscape-smoke.ts",
    "verify:perf": "deno run -A scripts/verify/cdp.ts scripts/verify/checks/perf.ts",
    "verify:detail-focus": "deno run -A scripts/verify/cdp.ts scripts/verify/checks/detail-focus.ts",
    "verify:detail-focus:mobile": "deno run -A scripts/verify/cdp.ts --device=mobile scripts/verify/checks/detail-focus.ts",
    "fmt:ci": "deno run --allow-read=.github,.outputs --allow-write=.outputs --allow-net=github.com,release-assets.githubusercontent.com,objects.githubusercontent.com --allow-run=unzip,.outputs/claude/deno-pinned/bin/deno scripts/fmt_ci.ts",
    "test": "deno test --allow-read=data,docs,src,scripts,index.html,app.css,.github/purge-paths.txt,.github/workflows --allow-env=NODE_ENV",
    "test:quiet": "NO_COLOR=1 deno test --reporter=dot --allow-read=data,docs,src,scripts,index.html,app.css,.github/purge-paths.txt,.github/workflows --allow-env=NODE_ENV",
    "test:watch": "deno test --allow-read=data,docs,src,scripts,index.html,app.css,.github/purge-paths.txt,.github/workflows --allow-env=NODE_ENV --watch"
  },
  "imports": {
    "@deck.gl/core": "npm:@deck.gl/core@^9.3.7",
    "@deck.gl/extensions": "npm:@deck.gl/extensions@^9.3.7",
    "@deck.gl/layers": "npm:@deck.gl/layers@^9.3.7",
    "@deck.gl/mapbox": "npm:@deck.gl/mapbox@^9.3.7",
    "@mapbox/polylabel": "npm:@mapbox/polylabel@^1.0.2",
    "@protomaps/basemaps": "npm:@protomaps/basemaps@^5.7.2",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/csv": "jsr:@std/csv@^1",
    "@std/http": "jsr:@std/http@^1",
    "@std/path": "jsr:@std/path@^1",
    "@std/yaml": "jsr:@std/yaml@^1",
    "@turf/area": "npm:@turf/area@^7",
    "@turf/bbox-clip": "npm:@turf/bbox-clip@^7",
    "@turf/boolean-point-in-polygon": "npm:@turf/boolean-point-in-polygon@^7",
    "@turf/difference": "npm:@turf/difference@^7",
    "@turf/helpers": "npm:@turf/helpers@^7",
    "@turf/intersect": "npm:@turf/intersect@^7",
    "@turf/kinks": "npm:@turf/kinks@^7",
    "@turf/line-split": "npm:@turf/line-split@^7",
    "@turf/simplify": "npm:@turf/simplify@^7",
    "@turf/truncate": "npm:@turf/truncate@^7",
    "@turf/union": "npm:@turf/union@^7",
    "geojson": "npm:@types/geojson@^7946.0.16",
    "maplibre-gl": "npm:maplibre-gl@^4.7.1",
    "shapefile": "npm:shapefile@0.6.6",
    "pmtiles": "npm:pmtiles@^3.2.1"
  }
}
